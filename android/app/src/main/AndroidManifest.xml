<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pas besoin d'internet - l'app fonctionne 100% offline -->

    <!-- Vibration : retour haptique sur les boutons de saisie -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Téléchargement CSV : écriture dans Téléchargements, uniquement Android 9 et moins
         (Android 10+ passe par MediaStore sans permission) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="VB EPS"
        android:supportsRtl="true"
        android:theme="@style/Theme.VbEps"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
